<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    turtlebot3_house_with_human.world
    Based on turtlebot3_house.world (ROBOTIS-GIT/turtlebot3_simulations)
    Added: Gazebo Classic actor using the built-in cmu-13_26.bvh walk animation.

    Human location in /map frame: x=6.1, y=-4.4, z=0.0
  -->
  <world name="default">
    <scene>
      <shadows>0</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0.319654 -0.235002 9.29441 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="turtlebot3_house">
      <static>1</static>
      <include>
        <uri>model://turtlebot3_house</uri>
      </include>
    </model>

    <!--
      ══════════════════════════════════════════════════════════════
      HUMAN ACTOR
      Uses Gazebo Classic 11 built-in actor + cmu-13_26.bvh (walk).
      The actor is placed at x=6.1, y=-4.4 and walks a tiny
      0.001 m/s loop — effectively standing
      still while still playing the animation skeleton.

      To make it truly stationary, set <animation_factor> to 0 and
      the trajectory loop to a single waypoint.

      human_location to publish in project_status/msg/Status:
        x = 6.1,  y = -4.4,  z = 0.0  (ignore z)
      ══════════════════════════════════════════════════════════════
    -->
    <actor name="human">

      <!-- World position: x=6.1, y=-4.4, yaw=0.0 -->
      <pose>6.1 -4.4 0 0 0 0.0</pose>

      <!-- Built-in Gazebo skin — no external mesh needed -->
      <skin>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
      </skin>

      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <!-- interpolate_x: actor moves along the animation's root motion -->
        <interpolate_x>true</interpolate_x>
      </animation>

      <script>
        <!-- Loop a tiny triangle so the actor stays near x=6.1, y=-4.4 -->
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>

        <trajectory id="0" type="walking">
          <!-- Waypoint 1: home position -->
          <waypoint>
            <time>0</time>
            <pose>6.1 -4.4 0 0 0 0.0</pose>
          </waypoint>
          <!-- Waypoint 2: tiny step so Gazebo has a valid trajectory -->
          <waypoint>
            <time>10</time>
            <pose>6.1 -4.4 0 0 0 0.0</pose>
          </waypoint>
        </trajectory>
      </script>

    </actor>

  </world>
</sdf>
